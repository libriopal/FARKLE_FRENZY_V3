{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@farkle/shared": ["../../packages/shared/src/types.ts"],
      "@farkle/shared/*": ["../../packages/shared/src/*"],
      "@farkle/engine": ["../../packages/engine/src/index.ts"],
      "@farkle/engine/*": ["../../packages/engine/src/*"]
    }
  },
  "include": ["src"]
}
